{
  "name": "demo-pipeline",
  "version": "1.0.0",
  "description": "Self-updating AI demo video pipeline - Phase 0 PoC",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "demo": "node src/pipeline.js",
    "check": "node src/pipeline.js --check",
    "refresh": "node src/pipeline.js --check --auto-rerecord",
    "desktop": "node surfaces/desktop/record-desktop.js",
    "desktop:rigtest": "xvfb-run -a node surfaces/desktop/record-desktop.js --config surfaces/desktop/rig-config.json",
    "desktop:poc": "node surfaces/desktop/record-desktop.js --config surfaces/desktop/poc-config.json",
    "web": "node surfaces/web/record-web.js",
    "web:probe": "node surfaces/web/record-web.js --probe",
    "web:poc": "node surfaces/web/record-web.js --config surfaces/web/poc-config.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.2.0",
    "ffmpeg-static": "^5.3.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.62.0"
  }
}
